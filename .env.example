# Runtime
PORT=8787
APP_ORIGIN=http://127.0.0.1:4173
# Browser sessions use a host-only HttpOnly cookie. Secure defaults to true for HTTPS.
SESSION_COOKIE_NAME=priorilearn_session
SESSION_COOKIE_SECURE=false
# Defaults to true when NODE_ENV=production.
ENFORCE_ORIGIN_CHECK=false
# Authentication endpoints are limited per IP and route.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# AI-backed planning/coaching calls are limited per authenticated user.
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=3600000
STRUCTURED_LOGS=false
PERSISTENCE_DRIVER=postgres
STORAGE_DIR=var/uploads

# OpenAI. Used for PDF, image, text, and unfamiliar-layout extraction. Without
# a key, the API uses a deterministic demo provider and labels that result.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Render polls durable extraction jobs in small bounded batches.
EXTRACTION_WORKER_INTERVAL_MS=3000
EXTRACTION_WORKER_BATCH_SIZE=2

# PostgreSQL runtime identity. Production DATABASE_URL must use the restricted
# priorilearn_api role after provisioning; never give this URL migration rights.
DATABASE_URL=postgresql://priorilearn_api:replace-with-runtime-password@127.0.0.1:5432/priorilearn

# Local/CI migration identity only. Do not add this variable to Render.
DATABASE_MIGRATOR_URL=postgresql://priorilearn:priorilearn@127.0.0.1:5432/priorilearn
# Supabase: prefer verify-full with the project CA downloaded from Database Settings.
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA_PATH=C:\path\to\prod-ca-2021.crt
# Temporary encrypted fallback when that CA is not installed:
# DATABASE_SSL_MODE=require
# Used only by `npm run db:provision-runtime-role`; do not expose it to the browser.
DATABASE_RUNTIME_PASSWORD=replace-with-at-least-16-characters
# Optional staged rollout stop, for example 003_runtime_role_and_auth_bootstrap.sql.
MIGRATION_TARGET=

# Dedicated disposable test database. `test:postgres` refuses a non-test database.
DATABASE_URL_TEST=postgresql://postgres:priorilearn-test-local@127.0.0.1:15432/priorilearn_test

# Supabase Storage. Use the Project URL root (https://<project-ref>.supabase.co), not the REST URL ending in /rest/v1.
# Create a private bucket named priorilearn-documents, then use its service-role key only on the API service.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=priorilearn-documents

# Google Sign-In only. This client ID is public, but it must be configured on
# both services: the Vite client renders the official Google button and the API
# validates the issued ID token audience.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Shared demo and unverified password registration stay off in production.
ENABLE_DEMO_ACCESS=false
ENABLE_PASSWORD_REGISTRATION=false

# Transactional account email. Keep both values on the API service only.
# EMAIL_FROM must use a sender/domain verified by the email provider.
RESEND_API_KEY=
EMAIL_FROM=PrioriLearn <noreply@example.com>

# Opt-in browser notifications. Generate one persistent pair with:
# npx.cmd web-push generate-vapid-keys --json
# Keep the private key on the API service only. WEB_PUSH_SUBJECT can be the
# stable HTTPS production origin; no paid custom domain is required.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://priori-learn-kasdies-projects.vercel.app

# Hosted error reporting. The server DSN stays on Render. The browser DSN is
# intentionally public, but user/content data is scrubbed before every event.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# Optional Vercel build-only source map upload. SENTRY_AUTH_TOKEN is secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Maintenance endpoint in deployed environments
MAINTENANCE_SECRET=change-me
# Set only during a rotation, then remove after Vercel uses the new value.
MAINTENANCE_SECRET_PREVIOUS=

# Vercel Cron only. CRON_SECRET stays on Vercel; MAINTENANCE_SECRET must match Render.
CRON_SECRET=change-me-too
RENDER_API_ORIGIN=https://priorilearn-api.onrender.com
