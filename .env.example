# Runtime
PORT=8787
APP_ORIGIN=http://127.0.0.1:4173
PERSISTENCE_DRIVER=postgres
STORAGE_DIR=var/uploads

# OpenAI. Without a key, the API uses a deterministic demo provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# PostgreSQL runtime and migration target. Start it with: docker compose up -d postgres
DATABASE_URL=postgresql://priorilearn:priorilearn@127.0.0.1:5432/priorilearn

# Optional connector configuration. OAuth callback/token sync is not enabled until these integrations are completed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/connectors/google-calendar/callback
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_BASE_URL=
CANVAS_REDIRECT_URI=http://127.0.0.1:8787/api/connectors/canvas/callback

# Maintenance endpoint and token encryption in deployed environments
MAINTENANCE_SECRET=change-me
CONNECTOR_TOKEN_ENCRYPTION_KEY=
