{
  "manifest_version": 3,
  "name": "PrioriLearn Focus Companion",
  "version": "0.1.0",
  "description": "Starts a PrioriLearn focus session from a Canvas course page.",
  "action": {
    "default_title": "PrioriLearn Focus Companion",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.instructure.com/*", "https://canvas.*/*"]
}
