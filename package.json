{
  "name": "priorilearn-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "start:api:production": "node dist-server/server/index.js",
    "start": "npm run start:api:production",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:status": "tsx server/db/migration-status.ts",
    "db:migrate:production": "node dist-server/server/db/migrate.js",
    "db:provision-runtime-role": "tsx server/db/provision-runtime-role.ts",
    "build": "tsc -b && tsc -p server/tsconfig.json && tsc -p api/tsconfig.json && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:ui": "vitest run src/features",
    "test:watch": "vitest",
    "test:postgres": "tsx server/test/run-postgres-tests.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^1.24.0",
    "multer": "^2.2.0",
    "node-ical": "^0.26.1",
    "openai": "^6.47.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
